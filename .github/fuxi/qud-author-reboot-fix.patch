+/* Wait until the last control reply has actually left the controller.
+ *
+ * The reply is queued at the tail of the DWC3 transmit FIFO, and the console stream is frozen for
+ * the duration of the wait (see control_tx_frozen), so the FIFO occupancy reaching zero means the
+ * reply and everything queued before it has been handed to the host. The old code waited only for
+ * the CPU-side backlog to empty, which is already the case at this point, so the reset tore the
+ * controller down while the reply was still in the transmit FIFO and the host never saw it.
+ *
+ * The FIFO only empties when the controller completes the bulk-IN transfer, so this has to poll the
+ * hardware; sleeping alone would never move the bytes. Returns 1 when the reply left the
+ * controller, 0 on timeout or a transport failure. */
+static int control_wait_reply_sent(unsigned int timeout_ms)
+{
+    uint64_t flags;
+    uint64_t start, ticks;
+    int drained = 0;
+    if (!native.core_initialized) return 0;
+    if (!acquire(&flags)) return 0;
+    start = counter();
+    ticks = native.status.counter_frequency ? native.status.counter_frequency : 0;
+    while (native.status.phase == QCOM_USB_DEBUG_ACTIVE) {
+        if (dwc3_queued(native.core) == 0) { drained = 1; break; }
+        /* Poll the controller so the pending IN transfer can complete. */
+        if (dwc3_poll(native.core, 4) < 0) break;
+        if (ticks && counter() - start >= ticks * timeout_ms / 1000u) break;
+        delay_us(0, 100);
+    }
+    release(flags);
+    return drained;
+}
