 #include <sys/param.h>
+#include <pexpert/pexpert.h>
+
+/* fuxi 2026-11-16 (fuxi-dataprot-none.patch): Data has no data protection; answer class 4 ("none") instead of nothing. fuxi-dataprot=0 turns it off. */
+static int
+fuxi_dataprot_none(void)
+{
+	static int value = -1;
+	if (value < 0) {
+		int arg = 1;
+		if (!PE_parse_boot_argn("fuxi-dataprot", &arg, sizeof(arg))) {
+			arg = 1;
+		}
+		value = arg ? 1 : 0;
+	}
+	return value;
+}
