 /// # Safety
 ///
 /// `from` is `span` bytes of mapped memory, `span` at most [`TAG_BLOCK`].
+
+/// Copy `span` bytes at `from` into `into` with loads a cache-inhibited mapping answers: the C
+/// library's `memcpy` the compiler emits for a run-length `copy_nonoverlapping` loads 16-byte
+/// pairs (`ldnp q0, q1`), which fault with SIGBUS (an EL0 data abort, ESR DFSC 0x21, an alignment
+/// fault) on a mapping the kernel maps cache-inhibited — the fuxi scanout and surface mappings,
+/// whose base is only word aligned — where a run starts at a multiple of [`SYNC_BLOCK`] and not of
+/// 16. Eight-byte aligned volatile loads where both addresses allow them, bytes elsewhere: every
+/// cache-inhibited mapping answers those.
+///
+/// # Safety
+///
+/// `from` is `span` bytes of mapped readable memory; `into` is `span` bytes of the caller's own,
+/// apart from them.
+#[inline]
+unsafe fn copy_page_bytes(from: *const u8, into: *mut u8, span: usize) {
+    let mut at = 0;
+    while at < span && (((from as usize).wrapping_add(at) | (into as usize).wrapping_add(at)) & 7) != 0 {
+        // SAFETY: the caller's; one byte, which every mapping answers.
+        unsafe { into.add(at).write_volatile(from.add(at).read_volatile()) };
+        at += 1;
+    }
+    while at + 8 <= span {
+        // SAFETY: as above; eight bytes on an eight-byte boundary, which a cache-inhibited mapping answers.
+        let word = unsafe { (from.add(at) as *const u64).read_volatile() };
+        // SAFETY: as above, in the caller's own memory.
+        unsafe { (into.add(at) as *mut u64).write_volatile(word) };
+        at += 8;
+    }
+    while at < span {
+        // SAFETY: as above.
+        unsafe { into.add(at).write_volatile(from.add(at).read_volatile()) };
+        at += 1;
+    }
+}
