+/* fuxi-stall-hang: true once the CP sat on the same ring word and the same IB position with work left (RPTR != WPTR) for
+ * StallChecks checks in a row (2 s at the 500 ms hangcheck period). Any change, or an empty ring, starts the count again. */
+bool NativeAdrenoSubmit::cpStalled()
+{
+    uint32_t s[6]={};
+    if(ring(0)->cpPointers(s)) {stall_checks_=0;return false;}
+    bool same=true;
+    for(unsigned i=0;i<6;++i){if(s[i]!=stall_cp_[i])same=false;stall_cp_[i]=s[i];}
+    if(!same || (s[0]&0xffff)==(s[1]&0xffff)) {stall_checks_=0;return false;}
+    if(++stall_checks_<StallChecks)return false;
+    stall_checks_=0;
+    native_adreno_recover_trace[0]=8;native_adreno_recover_trace[1]=s[0]|(s[5]<<16);
+    return true;
+}
+IOReturn NativeAdrenoSubmit::injectStall()
+{
+    if(!attached_ || poisoned_)return kIOReturnNotReady;
+    NativeAdrenoRing *r=ring(0);
+    if(preemption() && ring(1) && ring(1)->current() && !r->current())r=ring(1);
+    return r->injectStall();
