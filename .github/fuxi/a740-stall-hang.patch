+/* fuxi-stall-hang */
+IOReturn NativeAdrenoRing::cpPointers(uint32_t out[6])
+{
+    static const uint32_t regs[6]={0x0806,0x0807,0x0928,0x092a,0x092d,0x0a66};
+    if(!out)return kIOReturnBadArgument;
+    if(!attached_)return kIOReturnNotReady;
+    for(unsigned i=0;i<6;++i)if(io_.read32(io_.cookie,regs[i],&out[i]))return kIOReturnIOError;
+    return kIOReturnSuccess;
+}
+/* fuxi-stall-hang: the reset prologue's wait (WRITE_EQ on RBBM_PERFCTR_SRAM_INIT_STATUS, mask 1) for the value 2, which the
+ * masked register can never hold: the CP stops on it until a restart. */
+IOReturn NativeAdrenoRing::injectStall()
+{
+    const uint32_t wait[6]={RingWaitWriteEq,RingPerfctrSramInitStatus,0,2,1,0};
+    uint32_t words[16]={};
+    const size_t n=packet(words,0,RingWaitRegMem,wait,6);
+    if(!n)return kIOReturnInternalError;
+    return submitUnfenced(words,n);
+}
