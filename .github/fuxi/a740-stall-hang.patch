+/* fuxi-stall-hang */
+IOReturn NativeAdrenoRing::stallState(uint32_t out[6])
+{
+    static const uint32_t regs[6]={0x0806,0x0807,0x0928,0x092a,0x092d,0x0a66};
+    if(!out)return kIOReturnBadArgument;
+    if(!attached_)return kIOReturnNotReady;
+    for(unsigned i=0;i<6;++i)if(io_.read32(io_.cookie,regs[i],&out[i]))return kIOReturnIOError;
+    return kIOReturnSuccess;
+}
