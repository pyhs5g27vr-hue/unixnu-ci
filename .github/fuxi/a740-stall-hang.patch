+bool NativeAdrenoSubmit::cpStalled()
+{
+    uint32_t s[6]={};
+    if(ring(0)->stallState(s)) {stall_checks_=0;return false;}
+    bool same=true;
+    for(unsigned i=0;i<6;++i){if(s[i]!=stall_cp_[i])same=false;stall_cp_[i]=s[i];}
